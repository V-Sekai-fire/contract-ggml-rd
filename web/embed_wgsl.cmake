# Embed the WGSL kernels as ggml_kernels::find(name) -> {name, bytes, size},
# the table shape kernels/embed_spv.py writes for SPIR-V.
#   cmake -DSRC=<dir of *.wgsl> -DOUT=<ggml_kernels.inc> -P embed_wgsl.cmake
file(GLOB FILES ${SRC}/*.wgsl)
list(SORT FILES)
set(T "// Generated by web/embed_wgsl.cmake. Do not edit.\n#pragma once\n#include <cstddef>\n#include <cstdint>\n\nnamespace ggml_kernels {\n\n")
set(E "")
foreach(F ${FILES})
	get_filename_component(K ${F} NAME_WE)
	file(READ ${F} W)
	string(APPEND T "static const char k_${K}[] = R\"wgsl(${W})wgsl\";\n")
	string(APPEND E "\t{ \"${K}\", reinterpret_cast<const uint8_t *>(k_${K}), sizeof(k_${K}) - 1 },\n")
endforeach()
string(APPEND T "\nstruct Entry {\n\tconst char *name;\n\tconst uint8_t *bytes;\n\tsize_t size;\n};\n\nstatic const Entry kEntries[] = {\n${E}};\n")
string(APPEND T "static const size_t kCount = sizeof(kEntries) / sizeof(kEntries[0]);\n\n")
string(APPEND T "inline const Entry *find(const char *name) {\n\tfor (size_t i = 0; i < kCount; ++i) {\n\t\tconst char *a = kEntries[i].name;\n\t\tconst char *b = name;\n\t\twhile (*a && *a == *b) { ++a; ++b; }\n\t\tif (*a == 0 && *b == 0) return &kEntries[i];\n\t}\n\treturn nullptr;\n}\n\n} // namespace ggml_kernels\n")
file(WRITE ${OUT} "${T}")
