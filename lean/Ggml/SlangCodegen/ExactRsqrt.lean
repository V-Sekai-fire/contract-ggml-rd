/-- A binary `if` tree whose leaf `k` returns word `k`. -/
partial def wordTree (lo hi : Nat) : List SlangStmt :=
  if hi - lo ≤ 1 then [.ret (some (u (zenWords.getD lo 0)))]
  else
    let mid := (lo + hi) / 2
    [.ifThen (.bin "<" (v "w") (u mid)) (wordTree lo mid) (wordTree mid hi)]

def fnZenWord : SlangFunctionDecl :=
  { retType := u32
  , name := "zen2_word"
  , params := [⟨"w", u32, Semantic.none, none, none, .qIn⟩]
  , body := wordTree 0 zenWords.size }

def fnRsqrtZen2 : SlangFunctionDecl :=
  { retType := f32
  , name := "rsqrt_zen2"
  , params := [⟨"x", f32, Semantic.none, none, none, .qIn⟩]
  , body :=
      [ .declare u32 "bits" (some (asuint (v "x")))
      , .ifThen (.call "isnan" [v "x"]) [ .ret (some (v "x")) ] []
      , .declare u32 "ex" (some (band (shr (v "bits") (u 23)) (u 255)))
      , .ifThen (.bin "!=" (shr (v "bits") (u 31)) (u 0))
          [ .ret (some (asfloat (.ternary (eq (v "ex") (u 0)) (u 0xff800000) (u 0xffc00000)))) ] []
      , .ifThen (eq (v "ex") (u 0)) [ .ret (some (asfloat (u 0x7f800000))) ] []
      , .ifThen (eq (v "bits") (u 0x7f800000)) [ .ret (some (fl 0.0)) ] []
      , .declare u32 "idx" (some (shr (band (v "bits") (u 0x7fffff)) (u 11)))
      , .declare u32 "par" (some (.ternary (eq (band (v "ex") (u 1)) (u 1)) (u 0) (u 1)))
      , .declare u32 "n" (some (add (mul (v "par") (u 4096)) (v "idx")))
      , .declare u32 "wd" (some (.call "zen2_word" [shr (v "n") (u 4)]))
      , .declare i32 "res" (some (sub (.cast i32 (band (shr (v "wd") (mul (u 2) (band (v "n") (u 15)))) (u 3))) (.litInt 1)))
      , pf "scale" (.ternary (eq (v "par") (u 1)) (fl 2.0) (fl 1.0))
      , pf "t" (mul (add (mul (.cast f32 (v "idx")) (fl 2.0)) (fl 1.0)) (fl 0.0001220703125))
      , pf "xm" (mul (add (fl 1.0) (v "t")) (v "scale"))
      , pf "q" (.call "div_exact" [fl 8192.0, .call "sqrt_exact" [v "xm"]])
      , pf "qr" (.call "floor" [add (v "q") (fl 0.5)])
      , .declare i32 "y" (some (add (.cast i32 (v "qr")) (v "res")))
      , .declare i32 "sh" (some (shr (sub (.cast i32 (v "ex")) (.litInt 127)) (u 1)))
      , .declare u32 "eb" (some (bor (shl (.cast u32 (sub (.litInt 126) (v "sh"))) (u 23)) (shl (.cast u32 (sub (v "y") (.litInt 4096))) (u 11))))
      , pf "r0" (asfloat (v "eb"))
      , pf "r2" (mul (v "x") (v "r0"))
      , pf "hr" (mul (v "r0") (fl (-0.5)))
      , pf "h" (.call "fma" [v "r2", v "r0", fl (-1.0)])
      , .ret (some (.call "fma" [v "hr", v "h", v "r0"])) ] }

def rsqrtZen2Helpers : List SlangFunctionDecl :=
  [fnSqrtExact, fnDivExact, fnZenWord, fnRsqrtZen2]

end Ggml.SlangCodegen.ExactRsqrt
