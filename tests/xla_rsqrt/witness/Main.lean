import PlausibleWitnessDag
import RsqrtTable

/-!
# Is there a short formula for the rsqrtps estimate table of the AMD Ryzen 7 3800X?

Hypotheses are indices into three parametrised families. `PlausibleWitnessDag.resolve` runs its
ladder (plausible over `Fin 256`, `Fin 1024`, `Fin 4096`, then a deterministic read-back) with the
predicate "this hypothesis reproduces every one of the 2 x 4096 entries exactly".

* family 1, indices 0..1599: floor of linear interpolation between nodes of the exact function,
  node spacing 4/8/16/32, node values rounded to 0..7 extra bits, 5 sample offsets, 5 cut offsets;
* family 2, indices 1600..2691: floor of the tangent line of the exact function;
* family 3, indices 2692..4095: floor of the exact function at a coarser grid of the index (1, 2, 4, 8
  entries), 5 sample positions and 71 offsets.

A planted control (a table generated by one family-3 index) must be found at exactly that index.
-/

open PlausibleWitnessDag

namespace RsqrtWitness

def parse (s : String) : Array Nat := ((s.splitOn ",").map String.toNat!).toArray

def scaleOf (e : Nat) : Float := if e == 128 then 2.0 else 1.0

def xAt (e : Nat) (idx : Float) : Float := (1.0 + idx / 4096.0) * scaleOf e

def f (e : Nat) (idx : Float) : Float := 8192.0 / Float.sqrt (xAt e idx)

def pick (xs : Array Float) (i : Nat) : Float := xs.getD i 0.0

def cuts : Array Float := #[0.0, 0.25, 0.5, 0.75, 0.99]

/-- The value hypothesis `w` gives for entry `idx` of binade `e`. -/
def predict (e : Nat) (w : Nat) (idx : Nat) : Float :=
  if w < 1600 then
    let cut := pick cuts (w % 5)
    let a1 := w / 5
    let toff := pick cuts (a1 % 5)
    let toff := if a1 % 5 == 4 then 1.0 else toff
    let a2 := a1 / 5
    let rn := a2 % 2
    let a3 := a2 / 2
    let qb := a3 % 8
    let g := 2 ^ (a3 / 8 % 4 + 2)
    let sc := (2.0 : Float) ^ (Float.ofNat qb)
    let node (k : Nat) : Float :=
      let v := f e (Float.ofNat (k * g)) * sc
      (if rn == 0 then Float.floor v else Float.floor (v + 0.5)) / sc
    let j := idx / g
    let i := idx % g
    let aj := node j
    let aj1 := node (j + 1)
    Float.floor (aj + (aj1 - aj) * (Float.ofNat i + toff) / Float.ofNat g + cut)
  else if w < 2692 then
    let a := w - 1600
    let cpos := Float.ofNat (a % 21) / 20.0
    let off := -0.5 + Float.ofNat (a / 21 % 13) * 0.125
    let g := 2 ^ (a / 273 % 4 + 2)
    let j := idx / g
    let i := idx % g
    let xc := xAt e (Float.ofNat (j * g) + cpos * Float.ofNat g)
    let fc := 8192.0 / Float.sqrt xc
    let df := -0.5 * 8192.0 / (xc * Float.sqrt xc) * (scaleOf e / 4096.0)
    Float.floor (fc + df * (Float.ofNat i + 0.5 - cpos * Float.ofNat g) + off)
  else
    let a := w - 2692
    let m := a % 4
    let t := Float.ofNat (a / 4 % 5) / 4.0
    let c := -0.5 + 0.02 * Float.ofNat (a / 20)
    let step := 2 ^ m
    let iq := idx / step * step
    Float.floor (f e (Float.ofNat iq + t * Float.ofNat step) + c)

/-- Does hypothesis `w` reproduce every entry of both binades? -/
def reproduces (t127 t128 : Array Nat) (w : Nat) : Bool :=
  (List.range 4096).all (fun idx =>
    predict 127 w idx == Float.ofNat (t127.getD idx 0) && predict 128 w idx == Float.ofNat (t128.getD idx 0))

/-- Number of entries hypothesis `w` gets wrong. -/
def wrong (t127 t128 : Array Nat) (w : Nat) : Nat :=
  (List.range 4096).foldl (fun acc idx =>
    acc + (if predict 127 w idx == Float.ofNat (t127.getD idx 0) then 0 else 1)
        + (if predict 128 w idx == Float.ofNat (t128.getD idx 0) then 0 else 1)) 0

def levels : Array Level := #[
  { idx := 0, walkSteps := 64,   finBound := 256,  numInst := 200 },
  { idx := 1, walkSteps := 512,  finBound := 1024, numInst := 800 },
  { idx := 2, walkSteps := 4096, finBound := 4096, numInst := 2000 } ]

def search (name : String) (t127 t128 : Array Nat) : IO Unit := do
  let (found, lvl, trace) ← resolve (α := Option Nat) name
    (fun _ w => reproduces t127 t128 w)
    (fun steps =>
      let hit := (List.range (min steps 4096)).find? (reproduces t127 t128)
      { value := hit, found := hit.isSome, witnessIdx := hit.getD 0, budgetHit := steps < 4096 })
    levels
  IO.println s!"{name}: level {lvl}, outcome {repr trace.outcome}, witness {found}"

end RsqrtWitness

open RsqrtWitness in
def main : IO Unit := do
  let t127 := parse raw127
  let t128 := parse raw128
  IO.println s!"table sizes {t127.size} {t128.size}"
  -- planted control: a table generated by family-3 index 3000 must be found at exactly 3000
  let plant (e : Nat) := (Array.range 4096).map (fun idx => (predict e 3000 idx).toUInt64.toNat)
  search "control: planted family-3 index 3000" (plant 127) (plant 128)
  -- the real table
  search "rsqrtps table of the Ryzen 7 3800X" t127 t128
  -- how close does the best hypothesis come?
  let mut best := (1000000, 0)
  for w in List.range 4096 do
    let n := wrong t127 t128 w
    if n < best.1 then best := (n, w)
  IO.println s!"closest hypothesis: index {best.2} gets {best.1} of 8192 entries wrong"
